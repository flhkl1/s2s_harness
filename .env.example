# ── Shared LLM (used by BOTH adapters as controlled variable) ─────────────────
# KAME:     oracle stream (GPT-4.1 guidance)
# MoshiRAG: retrieval backend (knowledge lookup)
# Using the same model for both is what makes this a fair A/B comparison.
OPENAI_API_KEY=

# ── KAME ─────────────────────────────────────────────────────────────────────
KAME_HOST=localhost          # Railway internal hostname in prod
KAME_PORT=8998
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON (local)
                                  # base64-encode the JSON for Railway env vars

# ── MoshiRAG ─────────────────────────────────────────────────────────────────
MOSHIRAG_HOST=localhost      # Railway internal hostname in prod
MOSHIRAG_PORT=8999

# MoshiRAG sub-services (set at moshi-rag server startup, not harness startup)
REFERENCE_ENCODER_URL=http://localhost:8001   # moshirag-cond service
LLM_BASE_URL=https://api.openai.com/v1        # same as KAME oracle
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=${OPENAI_API_KEY}                 # moshi-rag uses a separate var name

# Gradium ASR (MoshiRAG speech-to-text backend)
STT_API_KEY=

# ── VAD — identical for both (controlled variable) ────────────────────────────
VAD_AGGRESSIVENESS=2    # 0 = least, 3 = most aggressive silence detection
VAD_SILENCE_MS=500      # ms of silence before end-of-speech is declared

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=logs

# ── Legacy / other adapters ───────────────────────────────────────────────────
DASHSCOPE_API_KEY=
